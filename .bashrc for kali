# ============================================
# 14. USEFUL FUNCTIONS
# ============================================
# Create and cd into directory
mkcd() { mkdir -p "$1" && cd "$1"; }

# Extract any archive
extract() {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2|*.tbz2) tar xjf "$1" ;;
            *.tar.gz|*.tgz)   tar xzf "$1" ;;
            *.bz2)            bunzip2 "$1" ;;
            *.rar)            unrar x "$1" ;;
            *.gz)             gunzip "$1" ;;
            *.tar)            tar xf "$1" ;;
            *.zip)            unzip "$1" ;;
            *.Z)              uncompress "$1" ;;
            *.7z)             7z x "$1" ;;
            *.xz)             unxz "$1" ;;
            *)                echo "Don't know how to extract '$1'" ;;
        esac
    else
        echo "'$1' is not a valid file!"
    fi
}

# Find files
ff() { find . -type f -iname "*$1*" 2>/dev/null | grep --color=auto -i "$1"; }

# Find directories
fd() { find . -type d -iname "*$1*" 2>/dev/null | grep --color=auto -i "$1"; }

# Show disk usage sorted
duh() { du -sh * | sort -h; }

# Show top 10 largest files
bigfiles() { find . -type f -exec du -h {} + | sort -rh | head -10; }

# Weather
weather() { curl -s "wttr.in/${1:-Delhi}?m" | head -n 7; }

# Show weather with more details
weather-full() { curl -s "wttr.in/${1:-Delhi}?m" | less; }

# Quick calculator
calc() { echo "scale=2; $*" | bc -l; }

# Show public IP with details
ipinfo() { curl -s "http://ip-api.com/json" | jq . 2>/dev/null || curl -s "http://ip-api.com/json"; }

# Open man page in vim
vman() { vim -c "Man $1" -c 'silent! only'; }

# Backup current directory
backupdir() {
    local dirname=$(basename "$PWD")
    cd ..
    tar -czf "${dirname}_$(date +%Y%m%d_%H%M%S).tar.gz" "$dirname"
    cd -
}

