    local bg=$1
    local fg=$2
    local text=$3
    echo -n "\[\e[${bg}m\]\[\e[${fg}m\] $text \[\e[0m\]"
}

segment_continue() {
    local bg=$1
    local fg=$2
    local text=$3
    local next_bg=$4
    echo -n "\[\e[${bg}m\]\[\e[${fg}m\] $text \[\e[0m\]"
    echo -n "\[\e[${bg}m\]\[\e[${next_bg}m\]${separator}\[\e[0m\]"
}

segment_end() {
    local bg=$1
    local fg=$2
    local text=$3
    echo -n "\[\e[${bg}m\]\[\e[${fg}m\] $text \[\e[0m\]"
}

