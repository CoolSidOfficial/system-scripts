# ----------------------------
# MAIN PROMPT
# ----------------------------
PROMPT_COMMAND='__set_prompt'

__set_prompt() {
    local exit_code=$?

    # Get info
    local user=$(whoami)
    local host=$(hostname)
    local pwd_dir=$(pwd | sed "s|$HOME|~|")
    local git_branch=$(parse_git_branch)
    local git_status=$(parse_git_status)
    local git_dirty=$(get_git_dirty)
    local git_ahead=$(get_git_ahead)
    local git_behind=$(get_git_behind)
    local git_stashes=$(get_git_stashes)
    local load=$(get_load)
    local ram=$(get_ram)
    local ram_percent=$(get_ram_percent)
    local disk=$(get_disk)
    local disk_percent=$(get_disk_percent)
    local uptime=$(get_uptime)
    local time=$(get_time)

    # Build prompt
    PS1=""

    # Segment 1: Kali + User@Host
    PS1+="\[\e[48;5;52m\]\[\e[97m\] $kali_symbol $user@$host \[\e[0m\]"
    PS1+="\[\e[48;5;52m\]\[\e[48;5;236m\]${separator}\[\e[0m\]"

    # Segment 2: Directory
    PS1+="\[\e[48;5;236m\]\[\e[97m\]  $pwd_dir \[\e[0m\]"

    # Segment 3: Git (if in repo)
    if [ -n "$git_branch" ]; then
        PS1+="\[\e[48;5;236m\]\[\e[48;5;22m\]${separator}\[\e[0m\]"
        PS1+="\[\e[48;5;22m\]\[\e[97m\] $branch_symbol $git_branch\[\e[0m\]"

        [ -n "$git_status" ] && PS1+="\[\e[48;5;22m\]\[\e[93m\] *\[\e[0m\]"
        [ -n "$git_dirty" ] && PS1+="\[\e[48;5;22m\]\[\e[91m\] $git_dirty\[\e[0m\]"
        [ -n "$git_ahead" ] && PS1+="\[\e[48;5;22m\]\[\e[96m\] $git_ahead\[\e[0m\]"
        [ -n "$git_behind" ] && PS1+="\[\e[48;5;22m\]\[\e[93m\] $git_behind\[\e[0m\]"
        [ -n "$git_stashes" ] && PS1+="\[\e[48;5;22m\]\[\e[95m\] $git_stashes\[\e[0m\]"

        PS1+="\[\e[48;5;22m\]\[\e[48;5;17m\]${separator}\[\e[0m\]"
    else
        PS1+="\[\e[48;5;236m\]\[\e[48;5;17m\]${separator}\[\e[0m\]"
    fi

    # Segment 4: Load
    PS1+="\[\e[48;5;17m\]\[\e[97m\]  $load \[\e[0m\]"
    PS1+="\[\e[48;5;17m\]\[\e[48;5;30m\]${separator}\[\e[0m\]"

    # Segment 5: RAM
    PS1+="\[\e[48;5;30m\]\[\e[97m\]  $ram ($ram_percent) \[\e[0m\]"
    PS1+="\[\e[48;5;30m\]\[\e[48;5;166m\]${separator}\[\e[0m\]"

    # Segment 6: Disk
    PS1+="\[\e[48;5;166m\]\[\e[97m\]  $disk ($disk_percent) \[\e[0m\]"
    PS1+="\[\e[48;5;166m\]\[\e[48;5;0m\]${separator}\[\e[0m\]"

    # Segment 7: Uptime
    PS1+="\[\e[48;5;0m\]\[\e[97m\]  $uptime \[\e[0m\]"
    PS1+="\[\e[48;5;0m\]\[\e[48;5;52m\]${separator}\[\e[0m\]"

    # Segment 8: Time
    PS1+="\[\e[48;5;52m\]\[\e[97m\]  $time \[\e[0m\]"
    PS1+="\[\e[48;5;52m\]\[\e[0m\]"

    # New line with arrow
    PS1+="\n"

    # Arrow
    if [ $exit_code -eq 0 ]; then
        PS1+="\[\e[32m\]$arrow_symbol\[\e[0m\] "
    else
        PS1+="\[\e[31m\]$arrow_symbol\[\e[0m\] "
    fi
}

