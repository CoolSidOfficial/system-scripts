# ~/.bashrc - Enhanced Kali Style with More Features

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# ============================================
# 1. HISTORY - Bigger & Better
# ============================================
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend
HISTSIZE=10000
HISTFILESIZE=20000
HISTTIMEFORMAT="%F %T "
PROMPT_COMMAND="history -a; $PROMPT_COMMAND"

# ============================================
# 2. SHELL OPTIONS
# ============================================
shopt -s checkwinsize
shopt -s globstar
shopt -s extglob
shopt -s cdspell
shopt -s autocd 2>/dev/null

# ============================================
# 3. KALI PROMPT WITH GIT BRANCH
# ============================================
# Git branch in prompt
parse_git_branch() {
    git branch 2>/dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/(\1)/'
}

# Git status indicator
parse_git_status() {
    git status --porcelain 2>/dev/null | grep -q . && echo "*" || echo ""
}

# Kali Config
PROMPT_ALTERNATIVE=twoline
NEWLINE_BEFORE_PROMPT=yes

# Color setup
case "$TERM" in
    xterm-color|*-256color) color_prompt=yes;;
esac
force_color_prompt=yes

if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
        color_prompt=yes
    else
        color_prompt=
    fi
fi

if [ "$color_prompt" = yes ]; then
    VIRTUAL_ENV_DISABLE_PROMPT=1

    prompt_color='\[\033[;32m\]'
    info_color='\[\033[1;34m\]'
    git_color='\[\033[1;33m\]'
    prompt_symbol=㉿

    if [ "$EUID" -eq 0 ]; then
        prompt_color='\[\033[;94m\]'
        info_color='\[\033[1;31m\]'
        prompt_symbol=💀
    fi

    case "$PROMPT_ALTERNATIVE" in
        twoline)
            PS1=$prompt_color'┌──${debian_chroot:+($debian_chroot)──}${VIRTUAL_ENV:+(\[\033[0;1m\]$(basename $VIRTUAL_ENV)'$prompt_color')}('$info_color'\u'$prompt_symbol'\h'$prompt_color')-[\[\033[0;1m\]\w'$prompt_color']'$git_color'$(parse_git_branch)$(parse_git_status)'$prompt_color']\n'$prompt_color'└─'$info_color'\$\[\033[0m\] '
            ;;
    esac
    unset prompt_color info_color git_color prompt_symbol
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt force_color_prompt

# ============================================
# 4. COLOR SUPPORT
# ============================================
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    export LS_COLORS="$LS_COLORS:ow=30;44:di=1;36:ex=1;32"

    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
    alias diff='diff --color=auto'
